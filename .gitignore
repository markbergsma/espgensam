# ESPHome build directory & storage
.esphome/
build/

# Local credentials & custom local configs
secrets.yaml
.env
*-local.yaml

# GLM setup exports: they carry device serials, barcodes and AutoCal session data.
# Tests build a synthetic setup in tests/sam_fixture.py instead.
*.sam

# Compiled firmware binaries & maps
*.bin
*.elf
*.map

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# macOS system files
.DS_Store

# Local packet captures for debugging
captures/
tmp/